# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=low        # low | medium | high | xhigh | max

# Optional: require this code to view the site and call the API (unset = public).
# DEMO_ACCESS_CODE=

# Optional: presenter code. Entering it on /access grants access (like DEMO_ACCESS_CODE) and sets a
# 30-day presenter cookie that skips the rate limits. Unset = no presenter mode. Never commit it.
# PRESENTER_CODE=

# Per-visitor rate limits per hour (production only, or anywhere with RATE_LIMIT=on).
# RATE_LIMIT_CHAT_PER_HOUR=150
# RATE_LIMIT_WARM_PER_HOUR=30
