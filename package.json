{
  "name": "mccs-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:content": "node scripts/build-content.mjs",
    "eval": "node --env-file=.env.local scripts/eval/run.mjs",
    "eval:compare": "node scripts/eval/compare.mjs",
    "test:ui": "node --env-file=.env.local tests/ui/widget-check.mjs && node --env-file=.env.local tests/ui/front-door-check.mjs",
    "test:unit": "node --no-warnings --import ./tests/unit/alias-hooks.mjs tests/unit/limits-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@vercel/functions": "^3.10.3",
    "bootstrap": "5.3.2",
    "bootstrap-icons": "1.7.2",
    "cheerio": "^1.2.0",
    "globe.gl": "^2.46.2",
    "marked": "^18.1.2",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "h3-js": "^4.5.0",
    "playwright-core": "^1.64.1",
    "topojson-client": "^3.1.0",
    "typescript": "^5",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
